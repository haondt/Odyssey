@using Haondt.Web.UI.Components.Containers
@using Haondt.Web.UI.Components.Element
@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string Text { get; set; } = "More";

    [Parameter]
    public Optional<TooltipStyle> TooltipStyle { get; set; }

    [Parameter]
    public Optional<TooltipAlignment> TooltipAlignment { get; set; }

    [Parameter]
    public Optional<TooltipPosition> TooltipPosition { get; set; }

    [Parameter]
    public Optional<string> AddClasses { get; set; }

    protected HashSet<string> _rootClasses = ["more-button"];

    protected override void OnInitialized()
    {
        if (AddClasses.TryGetValue(out var addClasses))
            _rootClasses.Add(addClasses);
    }
}

@code{
    private RenderFragment RenderTooltip()  =>
        @<Tooltip Style="TooltipStyle" Align="TooltipAlignment.Or(Containers.TooltipAlignment.Right)" Position="TooltipPosition.Or(Containers.TooltipPosition.Below)" >@ChildContent</Tooltip>;
}

<div _="install MoreButton" class="@string.Join(' ', _rootClasses)">
    @if (TooltipPosition.Map(t => t == Containers.TooltipPosition.Above || t == Containers.TooltipPosition.LeftOf).Or(false))
    {
        @RenderTooltip();
    }
    <Button AddClasses='"more-button-button"' Style="ButtonStyle.Ghost">
        <Frame Flex="FrameDirection.Row" Gap="FrameSpacing.Line" Align="FrameAlignment.Center">
            <p>@Text</p>
            <LucideIcon Size="18" Name="chevron-down"/>
        </Frame>
    </Button>
    @if (!TooltipPosition.Map(t => t == Containers.TooltipPosition.Above || t == Containers.TooltipPosition.LeftOf).Or(false))
    {
        @RenderTooltip();
    }
</div>

@using Haondt.Web.UI.Components.Containers
@using Haondt.Web.UI.Components.Element
@using Haondt.Web.UI.Components.Relays

@code {
    [Parameter]
    public Optional<string> Title { get; set; }

    [Parameter]
    public Optional<string> CancelText { get; set; }

    [Parameter]
    public Optional<string> ConfirmText { get; set; }

    [Parameter, EditorRequired]
    public required string Message { get; set; }

    [Parameter, EditorRequired]
    public required ConfirmationDialogIntent Intent { get; set; }
}
<ModalPanel Template="ModalTemplate.Dialog">
    <div id="confirmation-dialog"> 
        @if (Title.TryGetValue(out var title))
        {
            <p class="subtitle">@title</p>
        }
        <p>@Message</p>
        <div class="confirmation-dialog-buttons">
            <Button Style="ButtonStyle.Ghost" Type="ButtonType.CloseModal">@CancelText.Or("Cancel")</Button>
            <Button Color="Intent.ButtonColor" Hyperscript='$"on click send confirm to #{ConfirmationDialogRelay.Id} end"' Type="ButtonType.CloseModal">@ConfirmText.Or("Confirm")</Button>
        </div>
    </div>
</ModalPanel>
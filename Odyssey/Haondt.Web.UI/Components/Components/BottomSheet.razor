@code {
    public const string Id = "bottom-sheet";
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
    [Parameter]
    public Optional<IComponent> Content { get; set; }
}

<div id="@Id">
    @ChildContent
    @if (Content.HasValue)
    {
        <ObjectComponent Component="Content.Value" />
    }
</div>
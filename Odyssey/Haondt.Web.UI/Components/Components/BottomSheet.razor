@code {
    public const string Id = "bottom-sheet";
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
    [Parameter]
    public Optional<IComponent> Content { get; set; }
}


@{
    var hs = @"
    install Swipeable()
    on odyssey:gesture:swipeDown
        halt the event
        if #bottom-sheet-content matches .active
            remove .active from #bottom-sheet-content
        end
    end
    ";
}
<div id="@Id" _="@hs">
    @ChildContent
    @if (Content.HasValue)
    {
        <ObjectComponent Component="Content.Value" />
    }
</div>

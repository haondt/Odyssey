@code {
    public const string Id = "bottom-sheet";
    [Parameter]
    public bool HxSwapOob { get; set; } = false;
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
    [Parameter]
    public bool Active { get; set; } = false;
}

@{
    var classes = Active ? "active" : "";
}

<div id="@Id">
    <p>I am an empty bottom sheet</p>
    @ChildContent
</div>
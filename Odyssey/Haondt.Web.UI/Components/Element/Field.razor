@using Haondt.Web.UI.Components.Containers
@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
    [Parameter]
    public Optional<string> Title { get; set; }

    [Parameter]
    public bool Hidden { get; set; }

    [Parameter]
    public bool Autofocus { get; set; }

    [Parameter]
    public Optional<string> Form { get; set; } 

    [Parameter]
    public Optional<string> Description { get; set; }

    [Parameter]
    public FieldType Type { get; set; } = FieldType.Text;

    [Parameter]
    public List<DropdownOption> Options { get; set; } = [];

    [Parameter]
    public Optional<SuggestionSource> Suggestions { get; set; }

    [Parameter]
    public FieldSize Size { get; set; } = FieldSize.Fill;

    [Parameter]
    public Optional<string> Name { get; set; }

    [Parameter]
    public Optional<string> Placeholder { get; set; }

    [Parameter]
    public Optional<object> Value { get; set; }

    [Parameter]
    public Optional<FieldAutocomplete> Autocomplete { get; set; }

    [Parameter]
    public Optional<string> Error { get; set; }

    [Parameter]
    public Optional<bool> IsValid { get; set; }

    /// <summary>
    /// Uses <a href="https://htmx.org/attributes/hx-preserve/">hx-preserve</a> to keep the input element unchanged during swaps.
    /// Requires a unique, unchanging <see cref="Id" /> to work correctly.
    /// </summary>
    [Parameter]
    public bool HxPreserve { get; set; } = false;

    [Parameter]
    public Optional<string> Id { get; set; }

    protected Dictionary<string, object> _inputAttributes  = [];
    protected Dictionary<string, object> _inputProxyAttributes  = [];
    protected Dictionary<string, object> _labelAttributes  = [];

    protected HashSet<string> _inputClasses = ["input"];
    protected HashSet<string> _rootClasses = ["field"];

    [Parameter]
    public Optional<string> InputClasses { get; set; }

    protected override void OnInitialized() 
    {
        switch (Type)
        {
            case FieldType.Checkbox:
                {

                    if (Name.TryGetValue(out var name))
                        _inputAttributes["name"] = name;
                    if (Value.TryGetValue(out var value) && value is bool boolValue && boolValue)
                        _inputAttributes["checked"] = "";
                }
                break;
            case FieldType.Hidden:
                {
                    if (Name.TryGetValue(out var name))
                        _inputAttributes["name"] = name;

                    if (Value.TryGetValue(out var value))
                        _inputAttributes["value"] = value;
                }
                break;
            case FieldType.Text:
            case FieldType.Password:
            case FieldType.Search:
            case FieldType.LiveSearch:
                {

                    if (Placeholder.TryGetValue(out var placeholder))
                        _inputAttributes["placeholder"] = placeholder;

                    if (Size.CssClass.TryGetValue(out var size))
                        _inputClasses.Add(size);

                    if (Name.TryGetValue(out var name))
                        _inputAttributes["name"] = name;

                    if (Autocomplete.TryGetValue(out var autocomplete))
                        _inputAttributes["autocomplete"] = autocomplete.StringValue;

                    if (Value.TryGetValue(out var value))
                        _inputAttributes["value"] = value;
                }
                break;
            case FieldType.Dropdown:
                {
                    if (Suggestions.TryGetValue(out var value))
                    {
                        if (Size.CssClass.TryGetValue(out var size))
                            _inputClasses.Add(size);

                        if (value.Selected.TryGetValue(out var selected))
                            _inputAttributes["value"] = selected.Value.Or(selected.Text);

                        if (Name.TryGetValue(out var name))
                            _inputAttributes["name"] = name;
                    }
                    else
                    {
                        if (Size.CssClass.TryGetValue(out var size))
                            _inputClasses.Add(size);

                        if (Name.TryGetValue(out var name))
                            _inputAttributes["name"] = name;
                    }
                }
                break;
        }

        switch (Size)
        {
            case FieldSize.Fill:
                _rootClasses.Add("field-size-fill");
                break;
        }

        if (HxPreserve)
        {
            _inputAttributes["hx-preserve"] = true;
            _inputProxyAttributes["hx-preserve"] = true;
        }

        if (Id.TryGetValue(out var id))
        {
            _inputAttributes["id"] = id;
            _inputProxyAttributes["id"] = id + "--proxy";
            _labelAttributes["for"] = id;
        }

        switch (Type)
        {
            case FieldType.Checkbox:
                _inputAttributes["type"] = "checkbox";
                break;
            case FieldType.Text:
                _inputAttributes["type"] = "text";
                break;
            case FieldType.Password:
                _inputAttributes["type"] = "password";
                break;
            case FieldType.Search:
            case FieldType.LiveSearch:
                _inputAttributes["type"] = "search";
                break;
            case FieldType.Hidden:
                _inputAttributes["type"] = "hidden";
                break;
            case FieldType.Dropdown:
                if (Suggestions.HasValue)
                {
                    _inputAttributes["type"] = "hidden";
                }
                break;
        }

        if (Type == FieldType.LiveSearch)
            _inputAttributes["_"] = "on input debounced at 200ms send submit to the closest <form /> end";

        if (Form.TryGetValue(out var form))
            _inputAttributes["form"] = form;

        if (IsValid.HasValue && IsValid.Value == false)
            _rootClasses.Add("field-invalid");

        if (InputClasses.TryGetValue(out var inputClasses))
            _inputClasses.Add(inputClasses);

        if (Hidden)
            _rootClasses.Add("field-hidden");

        if (Autofocus)
            _inputAttributes["autofocus"] = true;
    }
}

<div class="@string.Join(' ', _rootClasses)">
    <Frame 
        Gap="FrameSpacing.Line"
        Flex="FrameDirection.Col"
        Align="FrameAlignment.Start">
        @if(Type == FieldType.Checkbox || Title.HasValue) 
        {
            <div class="label-container">
                @if(Type == FieldType.Checkbox)
                {
                    <input _="on change toggle @@checked on me" @attributes="_inputAttributes" class="@string.Join(' ', _inputClasses)" />
                    <i class="field-icon"></i>
                }
                @if(Title.TryGetValue(out var title))
                {
                    <label @attributes="_labelAttributes" class="field-title">@title</label>
                }
            </div>
        }
        @if(Type is FieldType.Text or FieldType.Password or FieldType.Search or FieldType.LiveSearch)
        {
            <input @attributes="_inputAttributes" class="@string.Join(' ', _inputClasses)" />
        } 
        @if(Type is FieldType.Dropdown && Suggestions.TryGetValue(out var suggestions))
        {
            <div _="on click from elsewhere send deactivate to the first .field-suggest-search-input in me" class="@string.Join(' ', _inputClasses)">
                <p @attributes="_inputProxyAttributes" _="on click send activate to the next .field-suggest-search-input" class="field-suggest-text @(suggestions.Selected.HasValue ? "" : "fg-border")">@suggestions.Selected.Map(q => q.Text).Or(Placeholder).Unwrap()</p>
                <input class="field-suggest-input" @attributes="_inputAttributes" />
                <Tooltip Hidden="true" Style="TooltipStyle.ContextMenu" Align="TooltipAlignment.Left">
                    <input class="field-suggest-search-input input mx-line mb-line" type="search" placeholder="Search" _="install FieldSuggest" />
                    @{
                        var suggestionsTargetAttributes = new Dictionary<string, object>
                        {
                            ["hx-get"] = suggestions.Uri,
                        };
                    }
                    <div 
                        @attributes="suggestionsTargetAttributes"
                        class="field-suggest-suggestions-target"
                        hx-trigger="update"
                        hx-include="previous .field-suggest-search-input"
                        hx-swap="innerHTML"
                        _="install FieldSuggestTarget"
                    ></div>
                </Tooltip>
            </div>
        }
        else if(Type is FieldType.Dropdown)
        {
            <div class="select-container">
                <select @attributes="_inputAttributes" class="@string.Join(' ', _inputClasses)">
                    @foreach(var option in Options)
                    {
                        var optionAttributes = new Dictionary<string, object>();
                        if (option.Value.TryGetValue(out var optionValue))
                            optionAttributes["value"] = optionValue;
                        if (option.Selected)
                            optionAttributes["selected"] = true;

                        <option @attributes="optionAttributes">@option.Text</option>
                    }
                </select>
            </div>
        } 
        @ChildContent
        @if(Error.TryGetValue(out var error)) 
        {
            <p class="validation-error">@error</p>
        }
        @if (Description.TryGetValue(out var description))
        {
            <p>@description</p>
        }
    </Frame>
</div>
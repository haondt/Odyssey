@using Haondt.Web.Core.Http
@using Haondt.Web.UI.Components.Components
@code {

    [Parameter]
    public Optional<string> Title { get; set; }

    [Parameter, EditorRequired]
    public required string Text { get; set; }

    [Parameter]
    public ToastSeverity Severity { get; set; } = ToastSeverity.Error;
    private string SeverityString { get; set; } = default!;

    [Parameter]
    public Optional<int> StatusCode { get; set; }

    [CascadingParameter]
    public IResponseData Response { get; set; } = default!;

    protected override void OnInitialized()
    {
        if(StatusCode.TryGetValue(out var statusCode))
            Response.Status(statusCode);

        SeverityString = Severity switch
        {
            ToastSeverity.Warning => "warning",
            ToastSeverity.Error => "danger",
            ToastSeverity.Success => "success",
            ToastSeverity.Info => "info",
            _ => throw new ArgumentException(Severity.ToString())
        };
    }
}

<div class="toast" _="install Toast" hx-swap-oob="afterbegin:#@ToastContainer.Id">
    <div class="toast-header">
        <p class="fg-@SeverityString">@Title.Or(Severity.ToString())</p>
        <button _="on click send deleted to the closest <div.toast />" class="toast-delete-button">
            <LucideIcon Size="16" Name="x" />
        </button>
    </div>
    <div class="toast-body">
        <p style="white-space:pre-wrap;">@Text</p>
    </div>
</div>

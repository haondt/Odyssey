@using Haondt.Web.Core.Attributes
@using Haondt.Web.UI.Components.Components
@using Haondt.Web.UI.Components.Containers
@using Haondt.Web.UI.Components.Element
@using Haondt.Web.UI.Models

@attribute [RenderPage]

<ContentContainer id='"index-container"'>
    <Frame
        AddAttributes='new Dictionary<string, Object>(){["hx-swap"] = "outerHTML", ["hx-boost"] = "true", ["hx-inherit"] = "hx-swap hx-boost hx-target", ["hx-target"] = "#index-container"}'
        Flex="FrameDirection.Col" Border="FrameBorder.Card" Padding="FrameSpacing.Card">
        <a href="/demo/modal-container">modal container</a>
        <a href="/demo/tooltip">tooltip</a>
        <a href="/demo/confirmation-dialog">confirmation dialog</a>
        <a href="/demo/more-button">more button</a> 
        <a href="/demo/smart-field">smart field</a> 
    </Frame>
</ContentContainer>

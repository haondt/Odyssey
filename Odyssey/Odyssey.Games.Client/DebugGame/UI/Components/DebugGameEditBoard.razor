@using Haondt.Web.Core.Http
@using Haondt.Web.UI.Components.Element
@using Haondt.Web.UI.Services
@using Microsoft.AspNetCore.Components.Web
@using Odyssey.Games.Client.Core.UI.BoardConfiguration
@using Odyssey.Games.Domain.DebugGame.Models
@inject IValidationStateReader ValidationState
@code {
    [Parameter, EditorRequired]
    public required DebugGameBoard Board { get; set; }
    [Parameter, EditorRequired]
    public required int Version { get; set; }

    [Parameter]
    public bool HxSwap { get; set; }

    private Dictionary<string, object> _rootAttributes = [];
    protected override void OnInitialized()
    {
        if (HxSwap || ValidationState.IsValidation) 
            _rootAttributes["hx-swap-oob"] = "morph:#debug-game-edit-board";
    }

}
<Frame AddAttributes="_rootAttributes" Id='"debug-game-edit-board"' Flex="FrameDirection.Col" Gap="FrameSpacing.Panel">
    <Field Id='"debug-game-version"' Hidden="true" Name='"version"' Value="@Version" HxPreserve="ValidationState.IsValidation"/>
    <Section Field="() => Board.Section" >
        <SmartField Base="Board" Field="static s => s.Section.SomeString"  />
        <SmartField Base="Board" Field="static s => s.Section.SomeOtherString"  />
    </Section>
    <SmartField Base="Board" Field="static s => s.SomeCheckbox"  />
</Frame>
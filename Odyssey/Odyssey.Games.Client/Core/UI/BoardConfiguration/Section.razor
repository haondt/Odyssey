@using System.Linq.Expressions
@using Haondt.Core.Models
@using Haondt.Web.Components
@using Haondt.Web.UI.Components.Components
@using Haondt.Web.UI.Components.Element
@using Haondt.Web.UI.Models
@using System.Reflection
@using System.ComponentModel.DataAnnotations
@code {
    [Parameter]
    public RenderFragment? ChildContent {get; set;}

    [Parameter]
    public bool Collapsible { get; set; } = true;

    [Parameter]
    public Optional<string> Name { get; set; }

    /// <summary>
    /// Will be used in conjunction with hx-preserve to preserve open state
    /// </summary>
    [Parameter]
    public Optional<string> HeaderId { get; set; }

    [Parameter]
    public Expression<Func<object>>? Field { get; set; }

    private HashSet<string> _rootClasses = ["section"];
    private HashSet<string> _headerClasses = ["section-header", "section-open"];
    private Dictionary<string, object> _headerAttributes = [];


    protected override void OnInitialized() 
    {
        if (Field is { } field) 
        {
            var (memberInfo, path) = ExpressionUtils.GetMemberInfo(field);
            var displayAttr = memberInfo.GetCustomAttribute<DisplayAttribute>();

            if (!Name.HasValue && displayAttr?.Name is { } name)
            {
                Name = name;
            }

            if (!HeaderId.HasValue)
                HeaderId = $"section-header--{StringFormatter.PascalToKebabCase(path.Replace('.', '-'))}";
        }
        if (!HeaderId.HasValue && Name.HasValue)
            HeaderId = $"section-header--{StringFormatter.PascalToKebabCase(Name.Value.Replace('.', '-'))}";

        if (Collapsible)
            _rootClasses.Add("section-collapsible");

        if (HeaderId.HasValue)
        {
            _headerAttributes["id"] = HeaderId.Value;
            _headerAttributes["hx-preserve"] = "";
        }
    }

}


<div class="@string.Join(' ', _rootClasses)">
    @if (Collapsible) 
    {
        <div @attributes="@_headerAttributes" class="@string.Join(' ', _headerClasses)"  _="on click toggle .section-open on me end">
            <LucideIcon Size="20" Name="chevron-right" />
            @if (Name.TryGetValue(out var name))
            {
                <p class="subtitle">@name</p>
            }
        </div>
    }
    else if (Name.HasValue)
    {
        <div @attributes="@_headerAttributes" class="@string.Join(' ', _headerClasses)">
            @if (Name.TryGetValue(out var name))
            {
                <p class="subtitle">@name</p>
            }
        </div>
    }
    <div class="section-content">
        @ChildContent
    </div>
</div>

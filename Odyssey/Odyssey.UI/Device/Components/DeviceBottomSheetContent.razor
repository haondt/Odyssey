@using Odyssey.Client.Device.Services
@using Odyssey.GrainInterfaces.Sessions.Models
@using Odyssey.UI.Device.Hubs
@inject IDeviceSessionService DeviceSession
@inject IClientDeviceService Device
@code {
    [Parameter]
    public bool SignalRSubscribe { get; set; } = true;
    public const string Id = "device-bottom-sheet-content";
    private bool _ready;
    private Optional<MemberPartyDetails> _party;
    private DeviceProfile _profile = default!;
    protected override async Task OnInitializedAsync()
    {
        _party = await Device.GetPartyAsync();
        _profile = await Device.GetDeviceProfileAsync();
        _ready = true;
        base.OnInitialized();
    }
}

@if (_ready)
{
    @if (SignalRSubscribe)
    {
        <template hx-target="#@Id" class="hidden" hx-swap="morph" signalr-connection="@Websocket.Id"
                  signalr-subscribe="@nameof(IDeviceHubReceiver<>.ReceivePartyEvent)"></template>
    }
    <Frame Id="@Id" Flex="FrameDirection.Col" Gap="FrameSpacing.Panel" Align="FrameAlignment.Stretch">
        <Frame Flex="FrameDirection.RowWrap" Gap="FrameSpacing.Line">
            <Frame Flex="FrameDirection.Col" Gap="FrameSpacing.Line" AddClasses='"flex-grow-1"'>
                <p id="display-bottom-sheet-title" class="title">@_profile.Name</p>
                <p class="italic">Web App</p>
                <Chip Text="@DeviceSession.DeviceId.ToString()" />
            </Frame>
            <Frame Template="FrameTemplate.ButtonContainer" Align="FrameAlignment.Start">
                @if (_party.HasValue)
                {
                    <Button HxPost="@OdysseyRoutes.Device.Party.Leave.Index" HxSwap='"none"'
                            HxVals='new HxVals(){ ["joinCode"] = _party.Value.JoinCode }' Style="ButtonStyle.Ghost"
                            Color="ButtonColor.Danger">Leave party</Button>
                }
                else
                {
                    <a hx-boost="true" href="@OdysseyRoutes.Roles.Index" Style="ButtonStyle.Ghost" Color="ButtonColor.Primary">
                        Change role
                    </a>
                }
            </Frame>
        </Frame>
        @if (_party.TryGetValue(out var party))
        {
            <Field Title='"Join code"' Type="FieldType.None">
                <Frame Flex="FrameDirection.Col" Gap="FrameSpacing.Line" AddClasses='"width-full"'>
                    <Frame Template="FrameTemplate.Card" Padding="FrameSpacing.Panel">
                        <p class="title uppercase monospace text-align-center">@party.JoinCode</p>
                    </Frame>
                </Frame>
            </Field>
            <Field Title='"Party members"' Type="FieldType.None">
                <Frame Template="FrameTemplate.Card" AddClasses='"width-full"'>
                    <VerticalList Gap="VerticalListSpacing.Line">
                        <VerticalListItem>
                            <Frame Flex="FrameDirection.Row" Gap="FrameSpacing.Card">
                                <p class="subtitle fg-primary">Haondt</p>
                                <p class="italic">Web App</p>
                            </Frame>
                        </VerticalListItem>
                        @foreach (var member in party.Members)
                        {
                            <VerticalListItem>
                                <Frame Flex="FrameDirection.Row" Gap="FrameSpacing.Card">
                                    <p class="subtitle">@member.Name</p>
                                    <p class="italic">@member.Type</p>
                                </Frame>
                            </VerticalListItem>
                        }
                    </VerticalList>
                </Frame>
            </Field>
        }
        else
        {
            <Field Title='"Party"' Type="FieldType.None">
                <Frame Flex="FrameDirection.Row" Justify="FrameJustification.Center" Padding="FrameSpacing.Card"
                       AddClasses='"bg-background-strong width-full"' Radius="FrameRadius.Card">
                    <p class="fg-text-weak">Not in a party</p>
                </Frame>
            </Field>
        }
    </Frame>
}

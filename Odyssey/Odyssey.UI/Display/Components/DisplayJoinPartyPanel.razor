@using Haondt.Web.UI.Components.Containers
@using Haondt.Web.UI.Services

@code {
    public const string Id = "device-join-party-panel";
}

<form id="@Id" hx-post="@OdysseyRoutes.Display.Party.Join.Index">
    <Frame Flex="FrameDirection.Col" Align="FrameAlignment.Stretch" Template="FrameTemplate.Card">
        <SmartField TBase="DisplayJoinPartyModel" Field="m => m.JoinCode" />
        <SmartField TBase="DisplayJoinPartyModel" Field="m => m.DisplayName" />
        <Button Type="ButtonType.Submit" Color="ButtonColor.Primary">Join</Button>
    </Frame>
</form>


@using Haondt.Web.UI.Components.Components
@using Haondt.Web.UI.Components.Containers
@using Haondt.Web.UI.Models
@using Odyssey.Client.Authentication.Services
@using Odyssey.Client.Core.Services
@using Odyssey.Domain.Core.Models
@using Odyssey.Domain.Core.Services
@using System.Text.Json
@using Odyssey.UI.Authentication.Components
@using Odyssey.UI.Core.Models
@using Odyssey.Persistence.Models
@using static Odyssey.UI.Host.Controllers.HostController
@inject IClientGameRegistry Games
@inject IBoardMetadataRepository Boards
@inject IHostSessionService Session
@code {
    [Parameter] public bool ForceLoadSessions { get; set; } = false;
    [Parameter] public List<(Guid Id, SessionMetadata Session)> Sessions { get; set; } = [];
    [Parameter] public Optional<string> CurrentSearch { get; set; }
    public const string Id = "host-sessions-list";

    private Dictionary<string, string> _gameNames = [];
    private Dictionary<Guid, string> _boardNames = [];
    private bool _ready = false;

    protected override async Task OnInitializedAsync()
    {
        foreach(var (_, session) in Sessions)
        {
            if (!_gameNames.ContainsKey(session.GameId))
            {
                var game = Games.GetGame(session.GameId);
                _gameNames[session.GameId] = await game.Settings.GetDisplayNameAsync(await Session.GetUserIdAsync());
            }
            if (!_boardNames.ContainsKey(session.BoardId))
            {
                _boardNames[session.BoardId] = session.BoardName;
            }
        }
        _ready = true;
    }
}

@if (_ready) {
    <VerticalList Clickable="true" Id="@Id">
        @foreach(var (id, session) in Sessions)
        {
            <VerticalListItem>
                <a hx-boost="true" href="@OdysseyRoutes.Host.Session.Index/@id">
                    <Frame Spacing="FrameSpacing.Card" Flex="FrameDirection.Col">
                        <Frame Gap="FrameSpacing.Card" Flex="FrameDirection.Row">
                            <p class="subtitle">@session.Name</p>
                            <p class="italic">@_gameNames[session.GameId]</p>
                            <p class="italic fg-text-weak">@session.BoardName</p>
                        </Frame>
                        <Frame Template="FrameTemplate.ChipContainer">
                            @switch(session.Status)
                            {
                                case SessionStatus.Created:
                                    <Chip Label='"Status"' Text="Created" Color="ChipColor.Text"/>
                                    break;
                                case SessionStatus.InProgress:
                                    <Chip Label='"Status"' Text="In progress" Color="ChipColor.Primary"/>
                                    break;
                                case SessionStatus.Ended:
                                    <Chip Label='"Status"' Text="Ended" Color="ChipColor.TextWeak"/>
                                    break;
                            }
                            <Chip Label='"Last played"' Text="@session.LastPlayedOn.Map(StringFormatter.FormatDate).Or("Never")" />
                            <Chip Label='"Created"' Text="@StringFormatter.FormatDate(session.CreatedOn)" />
                        </Frame>
                    </Frame>
                </a>
            </VerticalListItem>
        }
        @if(Sessions.Count > 0 || ForceLoadSessions)
        {
            var searchData = new HxVals()
            {
                ["search"] = CurrentSearch.Unwrap(),
                ["last"] = Sessions.Count > 0 ? new TemporalContinuationData<Guid>
                {
                    Id = Sessions[^1].Id,
                    Time = Sessions[^1].Session.LastPlayedOn.Unwrap()
                } : null
            };
            <InfiniteScrollTrigger
                HxGet="@OdysseyRoutes.Host.Sessions.Search.Index"
                HxVals="@searchData">
                <Skeleton>
                    <Frame Flex="FrameDirection.Col">
                        @for(int i = 0; i<2; i ++)
                        {
                            if (Sessions.Count > 0 || i > 0)
                            {
                                <HorizontalBar />
                            }
                            <Frame Spacing="FrameSpacing.Card" Flex="FrameDirection.Col" Align="FrameAlignment.Stretch">
                                <Frame Gap="FrameSpacing.Card" Flex="FrameDirection.RowWrap">
                                    <Chip Color="ChipColor.ChipBackground" Skeleton="250" />
                                </Frame>
                                <Frame Template="FrameTemplate.ChipContainer">
                                    <Chip Color="ChipColor.ChipBackground" Skeleton="200" />
                                </Frame>
                            </Frame>
                        }
                    </Frame>
                </Skeleton>
            </InfiniteScrollTrigger>
        }
    </VerticalList>
}

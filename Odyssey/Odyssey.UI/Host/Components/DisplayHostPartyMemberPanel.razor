@using Haondt.Web.UI.Components.Components
@using Odyssey.GrainInterfaces.Sessions.Models
@code {
    [Parameter, EditorRequired]
    public required PartyMemberId Id { get; set; }

    [Parameter, EditorRequired]
    public required DisplayProfile Profile { get; set; }

    [Parameter, EditorRequired]
    public required HostDisplayData Data { get; set; }

    private DisplayHostPartyMemberPanelModel _model = default!;

    protected override void OnInitialized()
    {
        _model = DisplayHostPartyMemberPanelModel.Create(Id.Id, Data);
    }

}

<Frame Template="FrameTemplate.Card" Flex="FrameDirection.Col" Gap="FrameSpacing.Line">
    <Frame Flex="FrameDirection.RowWrap" Gap="FrameSpacing.Line">
        <p class="subtitle">@Profile.Name</p>
        <p class="italic">Display</p>
        <p class="italic fg-text-weak">@Profile.Type</p>
        <HorizontalSpacer/>
        <Chip>@Id.Id</Chip>
    </Frame>
    <form class="flex flex-col gap-line" hx-trigger="input delay:200ms" hx-put="@OdysseyRoutes.Host.Party.Members.IdP(Id).DisplayP.IndexP">
        <SmartField Base="_model" Field="m => m.PlaySounds" />
        <SmartField Base="_model" Field="m => m.ReflectSoundboard" />
    </form>
    <Frame Template="FrameTemplate.ButtonContainer">
        <Button HxDelete="@OdysseyRoutes.Host.Party.Members.IdP(Id).IndexP" Style="ButtonStyle.Ghost" Color="ButtonColor.Danger">Remove</Button>
    </Frame>
</Frame>

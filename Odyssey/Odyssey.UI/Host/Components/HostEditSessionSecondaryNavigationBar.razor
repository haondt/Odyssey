@code {
    [Parameter, EditorRequired]
    public required HostEditSessionSecondaryNavigationBarTab ActiveTab {get; set;}

    [Parameter]
    public bool Sticky { get; set; } = true;

    [Parameter, EditorRequired]
    public required Guid Id { get; set; }

    private List<SecondaryNavigationBarItem> LeftItems = [];
    private List<SecondaryNavigationBarItem> RightItems = [];

    protected override void OnInitialized()
    {
        LeftItems = [
            new("Session overview", OdysseyRoutes.Host.Session.IdP(Id).IndexP, ActiveTab == HostEditSessionSecondaryNavigationBarTab.SessionOverview),
            new("Game state", OdysseyRoutes.Host.Session.IdP(Id).GameStateP.IndexP, ActiveTab == HostEditSessionSecondaryNavigationBarTab.GameState),
            new("Game state (raw)", OdysseyRoutes.Host.Session.IdP(Id).GameStateP.RawP.IndexP, ActiveTab == HostEditSessionSecondaryNavigationBarTab.GameStateRaw),
        ];
        RightItems = [];
    }

}

<SecondaryNavigationBar Sticky="@Sticky" LeftItems="@LeftItems" RightItems="@RightItems" Spacing="SecondaryNavigationBarSpacing.SpaceApart" />

@using Haondt.Web.UI.Components.Components
@using Haondt.Web.UI.Components.Containers
@using Haondt.Web.UI.Services
@using Odyssey.Client.Authentication.Services
@using Odyssey.Domain.Core.Services
@inject ISessionService SessionService
@inject IBoardMetadataRepository Boards
@inject IValidationStateReader ValidationState
@code {
    [Parameter]
    public Optional<Guid> BoardId { get; set; }

    [Parameter]
    public bool HxSwap { get; set; } = false;

    private bool _ready;
    private EditBoardMetadataPanelModel _model = default!;
    private Dictionary<string, object> _formAttributes = [];
    protected override async Task OnInitializedAsync()
    {
        if (BoardId.TryGetValue(out var id) && _model == null)
        {
            var metadata = await Boards.GetBoardMetadataAsync(new(await SessionService.GetUserIdAsync(), id));
            if (metadata.IsSuccessful)
                _model = new()
                {
                    Name = metadata.Value.Name
                };
            _formAttributes["hx-put"] = OdysseyRoutes.Host.Board.IdP(BoardId.Or(Guid.Empty).ToString()).MetadataP.IndexP;
        }
        if (_model is null)
            _model = new();
        if (ValidationState.IsValidation)
            _formAttributes["hx-preserve"] = true;
        _ready = true;
    }

}
@if(_ready) {
    <DialogContainer>
        <Body>
            <form class="hidden" id="edit-board-metadata-form" @attributes="_formAttributes"></form>
            <SmartField AutoFocus="true" Form='"edit-board-metadata-form"' Base="_model" Field="static m => m.Name"/>
        </Body>
        <Buttons>
            <Button Style="ButtonStyle.Ghost" Type="ButtonType.CloseModal">Cancel</Button>
            <Button Form='"edit-board-metadata-form"' Color="ButtonColor.Success" Type="ButtonType.Submit">Save</Button>
        </Buttons>
    </DialogContainer>
}

@code {
    [Parameter] 
    public required string Code { get; set; }
}

<Frame Flex="FrameDirection.Col" Gap="FrameSpacing.Line">
    <p class="subtitle">Join code</p>
    <Frame Template="FrameTemplate.Card" Padding="FrameSpacing.Panel">
        <p class="title uppercase monospace text-align-center">@Code</p>
    </Frame>
</Frame>
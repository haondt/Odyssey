
@code {
    public const string Id = "edit-session-metadata-section";
    [Parameter]
    public bool HxSwapOob {get;set;} = false;

    [Parameter]
    public required string Name { get; set; }
    private Dictionary<string, object> _rootAttributes = [];
    protected override void OnInitialized()
    {
        if (HxSwapOob)
            _rootAttributes["hx-swap-oob"] = "true";
    }


}


<div @attributes="_rootAttributes" id="@Id" class="flex flex-grow-1 flex-row flex-wrap-wrap align-items-flex-end gap-line">
    <p class="title">@Name</p><p class="title fg-text-weak">(archived)</p>
</div>

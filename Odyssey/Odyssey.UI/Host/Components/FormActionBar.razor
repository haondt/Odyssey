@using Haondt.Web.UI.Components.Components
@code {
    [Parameter, EditorRequired]
    public required string FormId { get; set; }

    private string _formSelector => $"#{FormId}";

    [Parameter]
    public bool SaveButton { get; set; } = true;

    [Parameter]
    public Optional<string> DiscardButtonPath { get; set; }

    [Parameter]
    public bool OmitFooterMargin { get; set; } = false;

    protected HashSet<string> _rootClasses = ["form-action-bar"];

    protected override void OnInitialized() 
    {
        if (OmitFooterMargin)
            _rootClasses.Add("form-action-bar-footer-marginless");
    }

}

<div class="@string.Join(' ', _rootClasses)">
    <HorizontalBar />
    <Frame  Padding="FrameSpacing.Line" Template="FrameTemplate.ButtonContainer">
        @if(DiscardButtonPath.TryGetValue(out var discardPath))
        {
            <Button HxGet="discardPath" HxSwap='"none"' Color="ButtonColor.Danger" Style="ButtonStyle.Ghost">Discard changes</Button>
        }
        @if(SaveButton)
        {
            <Button Hyperscript='$"on click send submit to {_formSelector} end"'  Color="ButtonColor.Success">Save changes</Button>
        }
    </Frame>
</div>
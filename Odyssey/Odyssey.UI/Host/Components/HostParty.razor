@using Haondt.Web.UI.Components.Components
@using Haondt.Web.UI.Components.Containers
@using Odyssey.Client.Host.Services
@using Odyssey.UI.Core.Services
@using Odyssey.UI.Host.Hubs
@attribute [RenderPage(Role = OdysseyRoles.Host)]
@implements IHasNavigationBarComponent

@code {
    public NavigationBar CreateNavigationBar() => new()
    {
        Template = new NavigationBarDefault(OdysseyRoles.Host)
    };
}

<ContentContainer>
    <div hx-swap="none" class="hidden" signalr-connection="@Websocket.Id" signalr-subscribe="@nameof(IHostHubReceiver<>.ReceivePartyEvent)"></div>
    <Frame Flex="FrameDirection.Col" Align="FrameAlignment.Stretch" Gap="FrameSpacing.Card">
    <Frame AddClasses='"sticky blend-shadow bg-background mb-blend z-1"' Gap="FrameSpacing.Card" Flex="FrameDirection.Col" Align="FrameAlignment.Stretch">
        <HostSecondaryNavigationBar Sticky="false" ActiveTab="HostSecondaryNavigationBarTab.Party" />
        <Frame Template="FrameTemplate.ButtonContainer">
            <Button HxSwap='"none"' HxPost="@OdysseyRoutes.Host.Party.Reset.Index" Color="ButtonColor.Danger" Style="ButtonStyle.Ghost">Disband party</Button>
        </Frame>
        <HorizontalBar />
    </Frame>
    <HostPartyPanel />
    </Frame>
</ContentContainer>

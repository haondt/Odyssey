@using Haondt.Web.UI.Components.Components
@using Haondt.Web.UI.Models
@using Haondt.Web.UI.Components.Containers
@using Microsoft.Extensions.DependencyInjection
@using Odyssey.Client.Authentication.Services
@using Odyssey.Client.Core.Services
@using Odyssey.Domain.Core.Models
@using Odyssey.Domain.Core.Services
@using Odyssey.Persistence.Models
@using Odyssey.UI.Core.Exceptions
@using Odyssey.UI.Core.Services
@attribute [RenderPage(Role = OdysseyRoles.Host)]
@implements IHasNavigationBarComponent
@inject ISessionMetadataRepository Sessions
@inject IHostSessionService HostSession
@inject IClientGameRegistry Games

@code {
    [Parameter, EditorRequired]
    public required Guid Id { get; set; }

    [Parameter, EditorRequired]
    public required SessionMetadata Session { get; set; }

    private string _gameName = default!;
    private (IComponent PlayersSummary, IComponent GameSummary) _sessionSummary = default!;

    public NavigationBar CreateNavigationBar() => CreateNavigationBar(Session.Name);
    public static NavigationBar CreateNavigationBar(string name) => new()
    {
        Template = new NavigationBarDefault(OdysseyRoles.Host)
        {
            Breadcrumbs = [
                new("Sessions", OdysseyRoutes.Host.Sessions.Index),
                new(name)
            ]
        }
    };

    private bool _ready = false;
    protected override async Task OnInitializedAsync()
    {
        var userId = await HostSession.GetUserIdAsync();
        var displayNames = await Games.GetDisplayNamesAsync(userId);
        _gameName = displayNames[Session.GameId];
        var game = Games.GetGame(Session.GameId);
        _sessionSummary = await game.UI.GetSessionSummaryComponentAsync((userId, Id));
        _ready = true;
    }
}

@if (_ready) {
    <ContentContainer>
        <Frame Flex="FrameDirection.Col" Align="FrameAlignment.Stretch" Gap="FrameSpacing.Panel">
            <Frame Gap="FrameSpacing.Card" Flex="FrameDirection.Col">
                <HostEditSessionSecondaryNavigationBar Id="@Id" ActiveTab="HostEditSessionSecondaryNavigationBarTab.SessionOverview" />
                <Frame Gap="FrameSpacing.Card" Flex="FrameDirection.RowWrap" Justify="FrameJustification.SpaceBetween" Align="FrameAlignment.Stretch">
                    <EditSessionMetadataSection Session="@Session" />
                    <Frame AddClasses='"flex-grow-1"' Template="FrameTemplate.ButtonContainer">
                        <Button Color="ButtonColor.Primary" HxPost="@OdysseyRoutes.Host.Session.IdP(Id).LaunchP.IndexP">Launch session</Button>
                        @{
                            var deleteConfirm = new ConfirmationDialogModel
                            {
                                Message = $"This is permanent and cannot be reversed. Are you sure you want to delete the session \"{Session.Name}\"?",
                                ConfirmText = "Delete",
                                Title = "Delete session"
                            };

                            var resetConfirm = new ConfirmationDialogModel
                            {
                                Message = $"This will revert the game back to its initial state. Are you sure you want to reset the session \"{Session.Name}\"?",
                                ConfirmText = "Reset",
                                Title = "Reset session",
                                Intent = ConfirmationDialogIntent.Destroy
                            };
                        }
                        <MoreButton TooltipStyle="TooltipStyle.ContextMenu">
                            <Button
                                HxGet="OdysseyRoutes.Host.Session.IdP(Id).MetadataP.IndexP"
                                HxSwap='"none"'
                                Style="ButtonStyle.Borderless">Rename</Button>
                            @if (Session.Archived) 
                            {
                                <Button HxSwap='"none"' HxPost="@OdysseyRoutes.Host.Session.IdP(Id).UnarchiveP.IndexP" Style="ButtonStyle.Borderless" Color="ButtonColor.TextWeak">Unarchive</Button>
                            }
                            else 
                            {
                                <Button HxSwap='"none"' HxPost="@OdysseyRoutes.Host.Session.IdP(Id).ArchiveP.IndexP" Style="ButtonStyle.Borderless" Color="ButtonColor.TextWeak">Archive</Button>
                            }
                            <Button HxSwap='"none"' HxPost="@OdysseyRoutes.Host.Session.IdP(Id).GameStateP.ResetP.IndexP" HxConfirm="@resetConfirm" Style="ButtonStyle.Borderless" Color="ButtonColor.Danger">Reset</Button>
                            <Button HxSwap='"none"' HxDelete='""' HxConfirm="@deleteConfirm" Style="ButtonStyle.Borderless" Color="ButtonColor.Danger">Delete</Button>
                        </MoreButton>
                    </Frame>
                </Frame>
            </Frame>
            <Frame Grid="FrameGrid.CollapsibleFillTwo" Gap="FrameSpacing.Card">
                <Frame Template="FrameTemplate.Card">
                    <p class="subtitle">Session</p>
                    @foreach(var (l, r) in new (string, string)[] {
                        ("Last played", Session.LastPlayedOn.Map(StringFormatter.FormatDate).Or("Never")),
                        ("Created", StringFormatter.FormatDate(Session.CreatedOn))
                    })
                    {
                        <Frame Flex="FrameDirection.Row" Justify="FrameJustification.SpaceBetween">
                            <p>@l</p><p>@r</p>
                        </Frame>
                    }
                </Frame>
                <Frame Template="FrameTemplate.Card">
                    <p class="subtitle">Game state</p>
                    <Frame Flex="FrameDirection.Row" Justify="FrameJustification.SpaceBetween">
                        <p>Game</p><p>@_gameName</p>
                    </Frame>
                    <Frame Flex="FrameDirection.Row" Justify="FrameJustification.SpaceBetween">
                        <p>Board</p><a hx-boost="true" href="@OdysseyRoutes.Host.Board.IdP(Session.BoardId).IndexP">@Session.BoardName</a>
                    </Frame>
                    <Frame Flex="FrameDirection.Row" Justify="FrameJustification.SpaceBetween">
                        <p>Status</p>
                        <p>@(Session.Phase switch { SessionPhase.Created => "Created", SessionPhase.InProgress => "In progress", SessionPhase.Ended => "Ended", _ => Session.Phase.ToString() })</p>
                    </Frame>
                </Frame>
                <Frame Template="FrameTemplate.Card">
                    <p class="subtitle">Players</p>
                    <ObjectComponent Component="@_sessionSummary.PlayersSummary" />
                </Frame>
                <Frame Template="FrameTemplate.Card">
                    <p class="subtitle">Game Summary</p>
                    <ObjectComponent Component="@_sessionSummary.GameSummary" />
                </Frame>
            </Frame>
        </Frame>
    </ContentContainer>
}

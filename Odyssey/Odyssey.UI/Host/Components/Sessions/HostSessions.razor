@using Haondt.Web.UI.Components.Containers
@using Haondt.Web.UI.Components.Htmx
@using Odyssey.UI.Core.Services
@using Haondt.Web.UI.Components.Components
@using Odyssey.Client.Authentication.Services
@using Odyssey.Domain.Core.Models
@using Odyssey.Domain.Core.Services
@attribute [RenderPage(Role = OdysseyRoles.Host)]
@implements IHasNavigationBarComponent

@code {
    public NavigationBar CreateNavigationBar() => new()
    {
        Template = new NavigationBarDefault(OdysseyRoles.Host)
    };
}

<ContentContainer>
    <Frame Flex="FrameDirection.Col" Align="FrameAlignment.Stretch">
        <Frame AddClasses='"sticky blend-shadow bg-background mb-blend z-1"' Gap="FrameSpacing.Card" Flex="FrameDirection.Col" Align="FrameAlignment.Stretch">
            <HostSecondaryNavigationBar Sticky="false" ActiveTab="HostSecondaryNavigationBarTab.Sessions" />
            <Frame Template="FrameTemplate.ButtonContainer">
                <form class="flex-grow-1" hx-get="@OdysseyRoutes.Host.Sessions.Search.Index" hx-target="#@HostSessionsList.Id" hx-swap="outerHTML">
                    <Field Name='"search"' Type="FieldType.LiveSearch" Placeholder='"Search"' />
                </form>
                <Button HxSwap='"none"' HxGet="@OdysseyRoutes.Host.Sessions.New.Index" Color="ButtonColor.Primary">New session</Button>
            </Frame>
            <HorizontalBar />
        </Frame>
        <HostSessionsList ForceLoadSessions="true" />
    </Frame>
</ContentContainer>

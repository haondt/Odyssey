@using Haondt.Web.Core.Extensions
@using Haondt.Web.Core.Http
@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.WebUtilities
@using Odyssey.Client.Display.Services
@using Odyssey.Core.Exceptions;
@using Odyssey.UI.Device.Filters
@using Odyssey.UI.Display.Filters
@code {
    public const string Id = "websocket";
    public const string TargetRoleId = "websocket-target-role";
    public const string DisplayIdId = "websocket-display-id";
    public const string DeviceIdId = "websocket-device-id";
    private string _instanceId { get; set; } = Guid.NewGuid().ToString();

    [Parameter]
    public string Role { get; set; } = OdysseyRoles.None;

    [CascadingParameter]
    public IRequestData RequestData { get; set; } = default!;

    private string _connect = default!;
    private Guid? _displayId;
    private Guid? _deviceId;

    protected override void OnInitialized()
    {
        _connect = Role switch
        {
            OdysseyRoles.Host => OdysseyRoutes.Hubs.Host.Browser.Index,
            OdysseyRoles.Display => OdysseyRoutes.Hubs.Display.Browser.Index,
            OdysseyRoles.Device => OdysseyRoutes.Hubs.Device.Browser.Index,
            OdysseyRoles.None => "",
            _ => throw ExceptionFactory.CasesExhaustedException(Role, "role")
        };

        // always forward display id if it is given
        if (DisplaySessionAttribute.TryGetDisplayId(RequestData, out var displayId))
        {
            if (Role == OdysseyRoles.Display)
                _connect = QueryHelpers.AddQueryString(_connect, DisplaySessionAttribute.DisplayIdQueryParameter, displayId.ToString());

            _displayId = displayId;
        }

        // always forward device id if it is given
        if (DeviceSessionAttribute.TryGetDeviceId(RequestData, out var deviceId))
        {
            if (Role == OdysseyRoles.Device)
                _connect = QueryHelpers.AddQueryString(_connect, DeviceSessionAttribute.DeviceIdQueryParameter, deviceId.ToString());

            _deviceId = deviceId;
        }
    }

}
@if (Role == OdysseyRoles.None)
{
    <form id="@Id" hx-get="@OdysseyRoutes.Fragments.Websocket.Index" hx-trigger="refresh" hx-swap="outerHTML"
          data-role="@Role" _="
        on UpdateWebsocket(role, displayId, deviceId)
            if role != my @@data-role
                set #@Websocket.TargetRoleId's value to role
                set #@Websocket.DisplayIdId's value to displayId
                set #@Websocket.DeviceIdId's value to deviceId
                set my @@data-role to role
                send refresh to me
            end
        end
        " data-instance-id="@_instanceId">
        <input type="hidden" id="@TargetRoleId" name="targetRole" value="@Role" />
        <input type="hidden" id="@DisplayIdId" name="@DisplaySessionAttribute.DisplayIdQueryParameter"
               value="@(_displayId.HasValue? _displayId.Value: "")" />
        <input type="hidden" id="@DeviceIdId" name="@DeviceSessionAttribute.DeviceIdQueryParameter"
               value="@(_deviceId.HasValue? _deviceId.Value: "")" />
    </form>
}
else
{
    <form id="@Id" hx-get="@OdysseyRoutes.Fragments.Websocket.Index" hx-trigger="refresh" hx-swap="outerHTML" signalr-connect="@_connect" data-role="@Role" 
        _="
            on UpdateWebsocket(role, displayId)
                if role != my @@data-role
                    set #@Websocket.TargetRoleId's value to role
                    set #@Websocket.DisplayIdId's value to displayId
                    set my @@data-role to role
                    send refresh to me
                end
            end
            on htmx:signalr:start(connectionId) set my @@data-connection-id to connectionId end
            on htmx:signalr:reconnected(connectionId) set my @@data-connection-id to connectionId end
            on htmx:signalr:close remove my @@data-connection-id end
        "
        data-instance-id="@_instanceId">
            <input type="hidden" id="@TargetRoleId" name="targetRole" value="@Role" />
            <input type="hidden" id="@DisplayIdId" name="@DisplaySessionAttribute.DisplayIdQueryParameter" value="@(_displayId.HasValue? _displayId.Value: "")" />
            @if (_displayId.HasValue)
            {
                <template _="on htmx:configRequest from <body /> set the event's detail.headers['@DisplaySessionAttribute.DisplayIdHeader'] to '@_displayId.Value' end"></template>
            }
            <input type="hidden" id="@DeviceIdId" name="@DeviceSessionAttribute.DeviceIdQueryParameter" value="@(_deviceId.HasValue? _deviceId.Value: "")" />
            @if (_deviceId.HasValue)
            {
                <template _="on htmx:configRequest from <body /> set the event's detail.headers['@DeviceSessionAttribute.DeviceIdHeader'] to '@_deviceId.Value' end"></template>
            }
    </form>
}
